{
  "name": "frameforge-local",
  "version": "0.1.0",
  "description": "A local-first AI animation studio using Ollama and Blender",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "studio.frameforge.local",
    "productName": "FrameForge Local",
    "directories": { "output": "dist" },
    "files": ["src/**/*", "package.json", "README.md"],
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true, "createDesktopShortcut": true }
  }
}
